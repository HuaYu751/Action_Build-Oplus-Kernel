fs/proc/version: attach oplus_dfr ioctl channel (CONFIG_OPLUS_DFR) — OKI 适配版 v2
2026-11-16 重新生成：OKI 树 version.c 带 pde/pde_make_permanent，原版上下文不匹配。
保留 pde_make_permanent（两分支通用），proc_ops 不再重复 PROC_ENTRY_PERMANENT。
已用 git apply --check 严格验证。

--- a/fs/proc/version.c
+++ b/fs/proc/version.c
@@ -16,11 +16,38 @@
 	return 0;
 }
 
+#ifdef CONFIG_OPLUS_DFR
+extern long oplus_dfr_dispatch(unsigned int cmd, unsigned long arg);
+
+static int version_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, version_proc_show, NULL);
+}
+
+static long version_proc_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long arg)
+{
+	return oplus_dfr_dispatch(cmd, arg);
+}
+
+static const struct proc_ops version_proc_ops = {
+	.proc_open	= version_proc_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+	.proc_ioctl	= version_proc_ioctl,
+};
+#endif
+
 static int __init proc_version_init(void)
 {
 	struct proc_dir_entry *pde;
 
+#ifdef CONFIG_OPLUS_DFR
+	pde = proc_create("version", 0, NULL, &version_proc_ops);
+#else
 	pde = proc_create_single("version", 0, NULL, version_proc_show);
+#endif
 	pde_make_permanent(pde);
 	return 0;
 }
